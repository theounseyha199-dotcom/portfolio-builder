# Browser-visible values must use NEXT_PUBLIC_.
NEXT_PUBLIC_API_URL=http://localhost:8081
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8082
NEXT_PUBLIC_KEYCLOAK_REALM=portfolio-builder
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=portfolio-frontend

# Used only by the Next.js server. Docker Compose resolves this service name internally.
BACKEND_INTERNAL_URL=http://backend:8081
