POSTGRES_USER=portfolio
POSTGRES_PASSWORD=change-me
# 5434 avoids clashing with a PostgreSQL server installed on the host.
POSTGRES_PORT=5434
PORTFOLIO_DB=portfolio_db
KEYCLOAK_DB=keycloak_db

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_PORT=8082
KEYCLOAK_REALM=portfolio-builder

BACKEND_PORT=8081
FRONTEND_PORT=3000
APP_ENCRYPTION_KEY=
# Generate a development key with:
# openssl rand -base64 32
NEXT_PUBLIC_API_URL=http://localhost:8081
BACKEND_INTERNAL_URL=http://backend:8081
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8082
NEXT_PUBLIC_KEYCLOAK_REALM=portfolio-builder
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=portfolio-frontend

STORAGE_TYPE=local
STORAGE_LOCAL_PATH=/app/storage
# Required only when STORAGE_TYPE=s3 (AWS S3, Cloudflare R2, or MinIO).
S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=

GITHUB_CLIENT_ID=Ov23lidWepUzSF6RwlGy
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8081/api/integrations/github/callback
FRONTEND_URL=http://localhost:3000

# Backend-only writing assistance; disabled until key and model are configured.
APP_ENCRYPTION_KEY=
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-3.6-flash
AI_TIMEOUT_SECONDS=15
AI_MAX_INPUT_LENGTH=5000
