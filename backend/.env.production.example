# Backend production configuration. Copy to backend/.env.production.
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/portfolio_db
SPRING_DATASOURCE_USERNAME=portfolio
SPRING_DATASOURCE_PASSWORD=
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI=
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_JWK_SET_URI=
APP_ENCRYPTION_KEY=
APP_CORS_ALLOWED_ORIGIN=

STORAGE_TYPE=s3
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=
FRONTEND_URL=

AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-3.6-flash
AI_TIMEOUT_SECONDS=15
AI_MAX_INPUT_LENGTH=5000
