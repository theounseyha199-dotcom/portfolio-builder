# Backend-only configuration. Copy to backend/.env for Docker Compose.
# Generate APP_ENCRYPTION_KEY with: openssl rand -base64 32
APP_ENCRYPTION_KEY=
APP_CORS_ALLOWED_ORIGIN=http://localhost:3000
# Browsers receive localhost tokens; the backend fetches signing keys internally.
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI=http://localhost:8082/realms/portfolio-builder
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_JWK_SET_URI=http://keycloak:8080/realms/portfolio-builder/protocol/openid-connect/certs

STORAGE_TYPE=local
STORAGE_LOCAL_PATH=/app/storage
# Required only when STORAGE_TYPE=s3 (AWS S3, Cloudflare R2, or MinIO).
S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=

GITHUB_CLIENT_ID=Ov23lidWepUzSF6RwlGy
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8081/api/integrations/github/callback
FRONTEND_URL=http://localhost:3000

# Backend-only writing assistance. Keep the key out of Git and browser variables.
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-3.6-flash
AI_TIMEOUT_SECONDS=15
AI_MAX_INPUT_LENGTH=5000
